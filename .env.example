# Copy to .env; keep private values out of Git. Restart the server after edits.
# Defaults below are for local HTTP. Production requires HTTPS and COOKIE_SECURE=true.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_URL=http://127.0.0.1:3001
FACTX_DATA_DIR=data
COOKIE_SECURE=false
# Optional: omit to generate a random first-run setup token automatically.
# FACTX_SETUP_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# Optional alternative env file: set FACTX_ENV_FILE in the launching shell.
# FACTX_ENV_FILE=path-to-private-env-file
# Vite API proxy override: set in the launching shell when using a different API port.
# FACTX_API_URL=http://127.0.0.1:3001

# Ollama: replace model placeholders with exact names from your service's /api/tags.
# Chat: assistant, assessment generation, and selectable-text timetable extraction.
# Embedding: document indexing and retrieval; re-index after changing this model.
# Vision: images and scanned timetable PDFs, plus assessment image references.
# Leave unset until installed; setting a model name does not download a model.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=your-installed-chat-model
# OLLAMA_EMBED_MODEL=your-installed-embedding-model
# OLLAMA_VISION_MODEL=your-installed-vision-model
# OLLAMA_API_KEY=your-service-secret-if-required

# Separately hosted Judge0 sandbox; leave blank until a real service is available.
JUDGE_URL=
JUDGE_TOKEN=

# Email recovery and verification: set real SMTP details to enable delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Port 465 uses implicit TLS; other ports require STARTTLS.
# SMTP_USER and SMTP_PASSWORD may be omitted for an authorized SMTP relay.
SUPPORT_EMAIL=
INSTITUTION_NAME=
# Enable only after mail delivery and verification links have been tested.
REQUIRE_EMAIL_VERIFICATION=false

# Local aggregate usage counts and private backups.
USAGE_ANALYTICS=true
# Set a private directory outside FACTX_DATA_DIR, excluded from Git.
# FACTX_BACKUP_DIR=.private-backups
BACKUP_INTERVAL_HOURS=24

# Academic risk ML has no model-name environment setting.
# Train/evaluate approved data and explicitly import a reviewed version;
# see ml/README.md. Ollama model settings do not activate academic risk ML.

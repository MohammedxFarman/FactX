PORT=3001
HOST=127.0.0.1
FACTX_DATA_DIR=./data
# Set a one-time setup token, or use the random token printed at first startup.
# FACTX_SETUP_TOKEN=
# Set true behind HTTPS in production.
COOKIE_SECURE=false

{
  "name": "factx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser-smoke.mjs && node tests/workflow-browser.mjs",
    "doctor": "node scripts/check-integrations.mjs",
    "verify": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.18",
    "@napi-rs/canvas": "^1.0.9",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.17.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "vite": "^6.3.0"
  }
}
